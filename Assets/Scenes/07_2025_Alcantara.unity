      m_Calls: []
  m_text: "<b>Resultado da miss\xE3o</b>\n<size=80%>Uma anomalia levou \xE0 perda
    da miss\xE3o.\nO PION-BR2 n\xE3o chegou \xE0 \xF3rbita.\n\nCausa: vazamento na
    veda\xE7\xE3o da c\xE2mara de\ncombust\xE3o do 1\xBA est\xE1gio, aos 33 s de
    voo.\n\n<size=70%>Fontes: AEB, Relat\xF3rio de gest\xE3o 2025;\nInnospace e CENIPA,
    2026</size></size>"
