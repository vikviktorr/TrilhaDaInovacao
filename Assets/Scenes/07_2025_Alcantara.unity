      m_Calls: []
  m_text: "<b>Resultado da miss\xE3o</b>\n<size=78%>22/12/2025, 22h13. Subida normal
    at\xE9 o Max-Q.\nAos 33 s, o g\xE1s vazou pela veda\xE7\xE3o e a c\xE2mara de\ncombust\xE3o
    do 1\xBA est\xE1gio rompeu. Sem empuxo, o foguete\nse partiu em 3 ou 4 partes,
    que explodiram ao cair\nna zona de seguran\xE7a do CLA. Ningu\xE9m se feriu.\nO
    PION-BR2 n\xE3o chegou \xE0 \xF3rbita.\n\n<size=72%>Fontes: FAB; Innospace; AEB
    e CENIPA, 2026</size></size>"
