  m_Name: 
  m_EditorClassIdentifier: 
  falas:
  - dublagem: {fileID: 0}
    legenda: "Bem-vindo \xE0 Trilha da Inova\xE7\xE3o, a feira tecnol\xF3gica do
      Maranh\xE3o."
    duracaoSemAudio: 3.3000002
  - dublagem: {fileID: 0}
    legenda: "Aqui voc\xEA vai percorrer quarenta anos de inova\xE7\xE3o, de 1980
      at\xE9 hoje."
    duracaoSemAudio: 3.96
  - dublagem: {fileID: 0}
    legenda: "Para andar, caminhe de verdade pela sala \u2014 fique dentro dos limites
      marcados no ch\xE3o."
    duracaoSemAudio: 4.9500003
  - dublagem: {fileID: 0}
    legenda: "Chegue perto de cada apresentador para ouvir a hist\xF3ria dele. Boa
      visita!"
    duracaoSemAudio: 3.96
  painelLegenda: {fileID: 744893691}
  fonteDeVoz: {fileID: 0}
  fade: {fileID: 711148145}
  pausaFinal: 1.5
