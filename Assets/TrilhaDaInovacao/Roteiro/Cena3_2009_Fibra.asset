  m_Script: {fileID: 11500000, guid: 81527ec83f7595731b84b8bf0187a569, type: 3}
  m_Name: Cena3_2009_Fibra
  m_EditorClassIdentifier: 
  titulo: "Rede Metropolitana de S\xE3o Lu\xEDs"
  ano: 2009
  tempoPrevisto: 35
  fonte: "RNP: rede de fibra \xF3ptica de 43 km conectando seis institui\xE7\xF5es
    a 1 Gbps (RNP, 2009). PENDENTE: nomes das seis institui\xE7\xF5es para rotular
    os pinos."
  falas:
  - id: intro
    texto: "S\xE3o Lu\xEDs, 2009. A RNP inaugura a Rede Metropolitana da cidade."
    audio: {fileID: 8300000, guid: b3bfccb180daa6802bdcf7e3707afe1a, type: 3}
    duracao: 0
  - id: numeros
    texto: "S\xE3o 43 quil\xF4metros de fibra \xF3ptica ligando seis institui\xE7\xF5es
      a 1 Gbps."
    audio: {fileID: 8300000, guid: 225868dd77179d0838c29004a5c620c9, type: 3}
    duracao: 0
  - id: dica
    texto: Toque no ponto grande que pulsa no mapa.
    audio: {fileID: 8300000, guid: 81fbecd1411757060891f9fe308d8553, type: 3}
    duracao: 0
  - id: veja
    texto: "Veja os centros de pesquisa se conectarem pela fibra \xF3ptica."
    audio: {fileID: 8300000, guid: d6544457b70dd5e378c8b37364654d8b, type: 3}
    duracao: 0
  - id: fim
    texto: Com a rede pronta, as ideias circulam. Vamos ver uma delas virar objeto.
    audio: {fileID: 8300000, guid: fc7960d5aa0b03695bae6718852ad127, type: 3}
    duracao: 0
