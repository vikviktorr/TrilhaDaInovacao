  ordem: 1
  periodo: "D\xE9cada de 1980"
  titulo: Os Primeiros Passos
  nomeNpc: "Pioneiro da inform\xE1tica local"
  papelNpc: Trabalhou nos primeiros centros de processamento de dados do estado.
  falas:
  - dublagem: {fileID: 0}
    legenda: "Seja bem-vindo aos anos 80! Naquela \xE9poca, um computador ocupava
      uma sala inteira."
    duracaoSemAudio: 4.29
  - dublagem: {fileID: 0}
    legenda: "Os primeiros centros de processamento de dados chegaram \xE0s institui\xE7\xF5es
      e empresas daqui."
    duracaoSemAudio: 4.29
  - dublagem: {fileID: 0}
    legenda: "Era o come\xE7o de tudo: poucos sabiam programar, e cada m\xE1quina
      nova era um acontecimento."
